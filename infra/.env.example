# Copy to .env and adjust if needed
APP_ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/hh_mvp
REDIS_URL=redis://redis:6379/0

# CORS for local UI
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

# HH OAuth placeholders (not used in stage 3)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
HH_OAUTH_AUTHORIZE_URL=https://hh.ru/oauth/authorize
HH_OAUTH_TOKEN_URL=https://hh.ru/oauth/token
AUTH_STATE_TTL_SECONDS=600
PUBLIC_BASE_URL=http://localhost:8000

# OpenAI (Stage 7)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT_SECONDS=20
COVER_LETTER_MIN_CHARS=400
COVER_LETTER_MAX_CHARS=4000
# Optional, JSON list (example): ["гарантирую","100%","лучший кандидат"]
# COVER_LETTER_FORBIDDEN_PHRASES=[]

# HH apply local limits (Stage 8)
HH_APPLY_DAILY_LIMIT=20
HH_APPLY_HOURLY_LIMIT=5
HH_APPLY_MAX_RETRIES=2

# Stage 9 sync
ADMIN_SYNC_TOKEN=
SYNC_INTERVAL_SECONDS=900
MAX_NEGOTIATIONS_PER_SYNC=200


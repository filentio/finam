# Backend base URL used by Next.js server-side proxy routes (/api/v1/*, /api/admin/*).
API_BASE_URL=http://localhost:8000

# Backward-compatible (older setups). Prefer API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-side only (do NOT prefix with NEXT_PUBLIC)
ADMIN_SYNC_TOKEN=

# Optional
NEXT_PUBLIC_APP_NAME=HH Apply MVP

